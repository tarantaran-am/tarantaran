// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  venues
  photographers
  videographers
  decor
  reels
  stylists
  dresses
  cakes
  cars
  hosts
  show
  choreographers
  catering
  dj
}

enum Marz {
  yerevan
  aragatsotn
  ararat
  armavir
  gegharkunik
  kotayk
  lori
  shirak
  syunik
  tavush
  vayots_dzor
}

enum ContactEventKind {
  reveal
  instagram
  facebook
  tiktok
  telegram
  whatsapp
  website
}

model Vendor {
  id            String         @id @default(dbgenerated("gen_random_uuid()"))
  slug          String         @unique
  nameHy        String?        @map("name_hy")
  nameRu        String         @map("name_ru")
  nameEn        String?        @map("name_en")
  descriptionHy String?        @map("description_hy")
  descriptionRu String         @map("description_ru")
  descriptionEn String?        @map("description_en")
  category      Category
  phone         String
  address       String?
  marzes        Marz[]
  instagram     String?
  facebook      String?
  tiktok        String?
  telegram      String?
  whatsapp      String?
  website       String?
  isPublished   Boolean        @default(true) @map("is_published")
  createdAt     DateTime       @default(now()) @map("created_at")
  photos        Photo[]
  contactEvents ContactEvent[]
  leads         VendorLead[]

  @@index([category, isPublished])
  @@map("vendors")
}

model Photo {
  id         String  @id @default(dbgenerated("gen_random_uuid()"))
  vendorId   String  @map("vendor_id")
  vendor     Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  blobUrl    String  @map("blob_url")
  isApproved Boolean @default(false) @map("is_approved")
  isCover    Boolean @default(false) @map("is_cover")
  sortOrder  Int     @default(0) @map("sort_order")

  @@map("photos")
}

/// One row per visitor, vendor, kind and day: repeats the same day are dropped.
/// `reveal` is a "show contacts" press; the other kinds are clicks on the vendor's links.
model ContactEvent {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  vendorId    String           @map("vendor_id")
  vendor      Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kind        ContactEventKind
  day         DateTime         @db.Date
  visitorHash String           @map("visitor_hash")
  locale      String
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([vendorId, kind, day, visitorHash])
  @@index([vendorId, day])
  @@map("vendor_contact_events")
}

/// A request sent to a vendor from the "send a request" form on the vendor page.
model VendorLead {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  vendorId        String    @map("vendor_id")
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  eventDate       DateTime? @map("event_date") @db.Date
  message         String?
  contactWhatsapp Boolean   @default(false) @map("contact_whatsapp")
  contactTelegram Boolean   @default(false) @map("contact_telegram")
  locale          String
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_leads")
}
